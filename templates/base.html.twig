<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}IceMove{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/logoicemove.png') }}" type="image/x-icon">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="IceMove est votre partenaire fitness pour des exercices adaptés à tous les niveaux. Réalisez des entraînements personnalisés, suivez vos progrès et atteignez vos objectifs de remise en forme. Rejoignez notre communauté dès aujourd'hui !">
        <meta name="keywords" content="fitness, exercices, entraînement, remise en forme, santé, bien-être, IceMove">
        <meta name="author" content="IceMove">
        

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}

            
        {% endblock %}
    </head>
   

    <body>
     {% block header %}
<header>

