{# templates/sceance/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Liste des séances{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des séances</h1> 

        {# Barre de recherche #}
        <form method="GET" class="mb-3">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Rechercher une séance..." value="{{ searchTerm }}">
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </div>
        </form>

        {# Vérifie si des séances existent #}
        {% if pagination.getTotalItemCount() == 0 %}
            <p>Aucune séance disponible.</p>
        {% else %}
            <table class="table table-striped">
                <thead>
                    <tr>
                        {# <th>ID</th> #}
                        <th>Titre</th>
                        <th>Jour</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {# Boucle sur chaque séance #}
                    {% for sceance in pagination %}
                        <tr>
                            {# <td>{{ sceance.id }}</td> #}
                            <td>{{ sceance.titre }}</td>
                            <td>{{ sceance.jour }}</td>
                            <td>{{ sceance.date ? sceance.date|date('d/m/Y') : 'Non définie' }}</td>
                            <td>{{ sceance.description|default('Aucune description') }}</td>
                            <td>
                                <a href="{{ path('app_sceance_show', {'id': sceance.id}) }}" class="btn btn-sm btn-info">Voir</a>
                                <a href="{{ path('app_sceance_edit', {'id': sceance.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                                <form method="POST" action="{{ path('app_sceance_delete', {'id': sceance.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sceance.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                                </form>
                                
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# Pagination #}
            <div class="d-flex justify-content-center">
                {{ knp_pagination_render(pagination) }}
            </div>
        {% endif %}
    </div>
        <a href ="{{path('app_sceance_new')}}"><button id="creerSeance">Créer</button></a>
     <a href="{{ path('app_accueil') }}"> retour accueil</a>
{% endblock %}