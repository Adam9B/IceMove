{# templates/sceance/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Liste des séances
{% endblock %}

{% block body %}

<style>

table{
	background-color:rgb(255, 255, 255);
}

td, tr{
	background-color:rgb(255, 255, 255);
}

p {
    text-align: center;
    font-size: 1rem;
    margin-top: 20px;
    color: #666;
  }

  /* Tableau */
  .table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
  }

  .table thead th {
    background-color: #f8f8f8;
    color: #000000;
    padding: 12px 15px;
    text-align: left;
    font-weight: bold;
    border-bottom: 1px solid #ccc;
  }

  .table tbody tr {
    background-color: #ffffff;
  }

  .table tbody td {
    padding: 12px 15px;
    border-bottom: 1px solid #ccc;
    color: #000000;
  }

  .table tbody tr:hover {
    background-color: #fafafa;
  }

  /* Actions */
  .action-cell {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .action-link,
  .delete-btn {
    display: inline-block;
    padding: 6px 12px;
    font-size: 0.85rem;
    border-radius: 4px;
    border: 1px solid #000000;
    color: #000000;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.3s ease;
    cursor: pointer;
  }

  .action-link:hover,
  .delete-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .delete-btn {
    border: none;
    background-color: transparent;
    color: #000000;
	font-weight: bold;
	cursor: pointer;
	font-size: 16px;
  }

  .delete-btn:hover {
    background-color:rgb(0, 0, 0);
    color: #fff;
  }

  /* Pagination */
  .d-flex {
    display: flex;
    justify-content: center;
    margin-top: 30px;
    gap: 5px;
    flex-wrap: wrap;
  }

  .pagination {
    list-style: none;
    display: flex;
    padding: 0;
    margin: 0;
  }

  .pagination li {
    margin: 0 2px;
  }

  .pagination li a,
  .pagination li span {
    display: block;
    padding: 6px 12px;
    color: #000000;
    text-decoration: none;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .pagination li.active span {
    background-color: #000000;
    color: #fff;
    border-color: #000000;
  }

  .pagination li a:hover {
    background-color: #eee;
  }

  /* Bouton Créer */
  #creerSeance {
    display: block;
    margin: 20px auto;
    padding: 10px 20px;
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #creerSeance:hover {
    background-color: #333;
  }

  /* Lien retour accueil */
  a {
    display: block;
    text-align: center;
    margin-right: 20px;
    color: #000000;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s ease;
  }

  a:hover {
    color: #777;
  }

  /* Responsive */
  @media (max-width: 768px) {
    h1 {
      font-size: 1.5rem;
    }

    .search-input {
      font-size: 0.9rem;
      padding: 10px 30px 10px 15px;
    }

    .table thead {
      display: none;
    }

    .table tbody td {
      display: block;
      padding: 10px 0;
      text-align: left;
      border: none;
    }

    .table tbody tr {
      padding: 15px 0;
      border-bottom: 1px solid #ccc;
    }

    .table tbody td::before {
      content: attr(data-label);
      float: left;
      font-weight: bold;
      color: #555;
      min-width: 100px;
    }

    .action-cell {
      flex-direction: column;
	  
    }
	
	tr td:first-child{
		font-weight: bold;
	}

	
  }

  /* Barre de recherche */
  .search-container {
	display: flex;
	justify-content: center;
	margin-bottom: 20px;
  }

  .search-input {
	width: 300px;
	padding: 10px 15px;
	font-size: 1rem;
	border-radius: 4px;
	border: 1px solid #ccc;
	transition: border-color 0.3s ease;
  }

  .search-input:focus {
	border-color: #000000;
  }

  .search-icon {
	position: absolute;
	right: 20px;
	top: calc(50% - 10px);
	cursor: pointer;
	
  }


</style>


	<div class="container">
		<h1>Liste des séances</h1>

		{# Barre de recherche #}
		<form method="GET" class="search-container">
		
			<input type="text" name="search" class="search-input" placeholder="Rechercher une séance..." value="{{ searchTerm }}">
			
			
		
	</form>

		{# Vérifie si des séances existent #}
		{% if pagination.getTotalItemCount() == 0 %}
			<p>Aucune séance disponible.</p>
		{% else %}
			<table class="table ">
				<thead>
					<tr>
						{# <th>ID</th> #}
						<th>Titre</th>
						<th>Date</th>
						<th>Description</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{# Boucle sur chaque séance #}
					{% for sceance in pagination %}
						<tr class='bg-light'>
							
							<td class='truncate'>{{ sceance.titre }}</td>
							<td>{{ sceance.date ? sceance.date|date('d/m/Y') : 'Non définie' }}</td>
							<td class='truncate'>{{ sceance.description|default('Aucune description') }}</td>
							<td>
							<div style="display:flex;  align-items: center; "><a href="{{ path('app_sceance_show', {'id': sceance.id}) }}">Voir</a>
								<a href="{{ path('app_sceance_edit', {'id': sceance.id}) }}">Modifier</a>
								<form method="POST" action="{{ path('app_sceance_delete', {'id': sceance.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exercice ?');" style="display:inline;">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sceance.id) }}">
									<button type="submit" class="delete-btn" >Supprimer</button>
								</form></div>
								

							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>

			{# Pagination #}
			<div class="d-flex justify-content-center">
				{{ knp_pagination_render(pagination) }}
			</div>
		{% endif %}
	</div>
	<a href="{{path('app_sceance_new')}}">
		<button id="creerSeance">Créer</button>
	</a>
	<a href="{{ path('app_accueil') }}">
		retour accueil</a>
{% endblock %}
