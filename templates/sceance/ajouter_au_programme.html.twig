{% extends 'base.html.twig' %}

{% block title %}Ajouter cette Séance à un Programme{% endblock %}

{% block body %}
    <h1>Ajouter la Séance : {{ sceance.titre }} à un Programme</h1>

    {% if programmes is empty %}
        <p>Aucun programme disponible, vous devez créer un programme</p>
        
        <a href="{{ path('app_programme_new') }}" class="btn btn-secondary">Créer un programme</a>
    {% else %}
        <form method="post">
            <div class="form-group">
                <label for="programme_id">Choisir un programme :</label>
                <select name="programme_id" id="programme_id" class="form-control">
                    {% for programme in programmes %}
                        <option value="{{ programme.id }}">{{ programme.titre }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group mt-2">
                <label for="jour">Jour :</label>
                <select name="jour" id="jour" class="form-control">
                    <option value="">-- Choisissez un jour --</option>
                    {% for jour in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                        <option value="{{ jour }}">{{ jour }}</option>
                    {% endfor %}
                </select>
            </div>

            <button class="btn btn-success mt-3">Ajouter au programme</button>
        </form>
    {% endif %}

   
{% endblock %}