{% extends 'base.html.twig' %}

{# templates/exercice/index.html.twig #}


{% block body %}
<header>
    <div class="headerExercice">
        <h1 class='titreH1' >Liste des exercices</h1></div>

	<a href="{{ path('app_accueil') }}" class='retourAccueil'>
		<img src="{{ asset('img/arrow-left-solid.svg') }}" alt="Description" class="img-fluid mx-auto  flecheRetour"></a>
</header>        
	{# Filtres #}
	<div class="filters">
		<form method="GET" action="{{ path('app_exercices') }}">
			<div>
				<label for="bodyPart">Groupe musculaire :</label>
				<select name="bodyPart" id="bodyPart" onchange="this.form.submit()">
					<option value="">Tous</option>
					{% for part in bodyParts %}
						<option value="{{ part }}" {{ selectedBodyPart == part ? 'selected' }}>{{ part }}</option>
					{% endfor %}
				</select></div>
			<div>
				<label for="equipment">Équipement :</label>
				<select name="equipment" id="equipment" onchange="this.form.submit()">
					<option value="">Tout</option>
					{% for equip in equipments %}
						<option value="{{ equip }}" {{ selectedEquipment == equip ? 'selected' }}>{{ equip }}</option>
					{% endfor %}
				</select>
</div>
			<div><label for="target">Cible :</label>
				<select name="target" id="target" onchange="this.form.submit()">
					<option value="">Tout</option>
					{% for tgt in targets %}
						<option value="{{ tgt }}" {{ selectedTarget == tgt ? 'selected' }}>{{ tgt }}</option>
					{% endfor %}
				</select></div>
                {# Cible #}
				
			
		</form>
	</div>

	{# Liste des exercices #}
	<div class="exercices ">
		{% for exercice in pagination %}
			<div class="exercice-card hidden">
				<img src="{{ exercice.gifUrl }}" alt="{{ exercice.nom }}">
				<p style="font-size:18px;">{{ exercice.nom }}</p>
				{# <p><strong>Groupe musculaire :</strong> {{ exercice.bodyPart }}</p>
				                <p><strong>Équipement :</strong> {{ exercice.equipment }}</p> #}
				<p>
					<strong>Cible :</strong>
					{{ exercice.target }}</p>

				{# Instructions #}
				{# <div class="instructions">
				                    <strong>Instructions :</strong>
				                    <ol>
				                        {% for instruction in exercice.instructions %}
				                            <li>{{ instruction }}</li>
				                        {% endfor %}
				                    </ol>
				                </div> #}
				<span class="buttonExoCard d-flex justify-content-evenly align-items-center">
					<a href="{{ path('exercice_show', {id: exercice.id, retour: 'liste'}) }}">Détail</a>
					<a href="{{ path('exercice_ajouter_a_seance', { id: exercice.id }) }}">
						Ajouter à une séance
					</a>
				</span>
			</div>
		{% endfor %}
	</div>

	{# Pagination #}
	<div class="pagination d-flex justify-content-center" style="text-align: center; font-size: 25px; color: black; text-decoration: none;">
		{{ knp_pagination_render(pagination) }}
	</div>
{% endblock %}
